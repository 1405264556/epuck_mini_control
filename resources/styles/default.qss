/* e-puck Mini workstation */
QWidget { color: #223139; font-family: "Microsoft YaHei UI", "Segoe UI"; font-size: 12px; }
QMainWindow, QDialog { background: #f4f6f7; }
QMenuBar, QToolBar, QStatusBar { background: #ffffff; border: none; }
QMenuBar { border-bottom: 1px solid #dce2e5; padding: 3px; }
QMenuBar::item { padding: 5px 10px; }
QMenuBar::item:selected, QMenu::item:selected { background: #e7f2ef; }
QMenu { background: #ffffff; border: 1px solid #d0dadd; padding: 4px; }
QMenu::item { padding: 7px 22px; }
QToolBar { spacing: 6px; padding: 6px; border-bottom: 1px solid #dce2e5; }
QToolButton { border: 1px solid transparent; border-radius: 4px; padding: 6px 10px; }
QToolButton:hover { background: #edf2f3; }
QToolButton:checked { color: #087f72; background: #e3f1ed; border-color: #aacfc6; }
QToolButton:disabled { color: #a0adb3; }
QStatusBar { border-top: 1px solid #dce2e5; padding: 2px; color: #596b73; }
QDockWidget::title { background: #eef2f3; color: #405660; padding: 7px 10px; border-bottom: 1px solid #dce2e5; }
QTabWidget::pane { background: #ffffff; border: 1px solid #dce2e5; }
QTabBar::tab { background: #f2f5f6; padding: 7px 12px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: #ffffff; color: #087f72; border-bottom-color: #087f72; }
QPushButton { background: #ffffff; border: 1px solid #cbd6da; border-radius: 4px; padding: 6px 10px; min-height: 18px; }
QPushButton:hover { background: #edf5f2; border-color: #70a99c; }
QPushButton:pressed { background: #dcece5; }
QPushButton:disabled { color: #a1adb2; background: #f1f4f5; border-color: #e1e7e9; }
QPushButton#emergencyStop { background: #d74950; color: #ffffff; border-color: #d74950; }
QPushButton#emergencyStop:hover { background: #be3840; }
QListView, QTableView { background: #ffffff; alternate-background-color: #f6f8f9; border: 1px solid #dce2e5; gridline-color: #e8edef; selection-background-color: #e0f0e9; selection-color: #223139; outline: none; }
QListView::item { padding: 4px; }
QListView::item:selected { background: #e0f0e9; }
QHeaderView::section { background: #eef2f3; color: #52666f; border: none; border-right: 1px solid #dce2e5; border-bottom: 1px solid #dce2e5; padding: 7px 5px; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background: #ffffff; border: 1px solid #cbd6da; border-radius: 4px; padding: 5px 7px; min-height: 18px; selection-background-color: #bde3d6; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border-color: #087f72; }
QComboBox:disabled, QSpinBox:disabled { color: #a0adb3; background: #f4f6f7; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #e0f0e9; selection-color: #223139; }
QGroupBox { background: transparent; border: none; border-top: 1px solid #dce2e5; margin-top: 16px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 0px; padding: 0 6px 0 0; color: #405660; }
QSlider::groove:horizontal { height: 5px; background: #dce5e8; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; background: #087f72; border-radius: 3px; }
QSlider::groove:vertical { width: 5px; background: #dce5e8; border-radius: 2px; }
QSlider::handle:vertical { height: 14px; margin: 0 -5px; background: #087f72; border-radius: 3px; }
QProgressBar { background: #e7edef; border: none; border-radius: 3px; text-align: center; min-height: 22px; }
QProgressBar::chunk { background: #a9d7c5; border-radius: 3px; }
QScrollBar:vertical { width: 10px; background: #eef2f3; }
QScrollBar:horizontal { height: 10px; background: #eef2f3; }
QScrollBar::handle { background: #b9c8ce; min-height: 28px; min-width: 28px; border-radius: 3px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QSplitter::handle { background: #dce2e5; width: 3px; height: 3px; }
QToolTip { background: #ffffff; color: #223139; border: 1px solid #bdcbd1; padding: 5px; }
